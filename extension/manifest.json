{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.11.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon48.png",
    "default_popup": "popup.html",
    "default_title": "YouTube Music Player"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "tabs",
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://music.youtube.com/*",
    "https://lrclib.net/*",
    "https://*.peerjs.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-music-player@nael.com",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "qrcode.min.js",
        "peerjs.min.js",
        "content-script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content-styles.css",
        "pip.css",
        "qrcode.min.js",
        "peerjs.min.js",
        "queue-bridge.js"
      ],
      "matches": [
        "*://music.youtube.com/*"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open extension popup"
    },
    "play-pause": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Play/Pause"
    },
    "next-track": {
      "suggested_key": {
        "default": "Ctrl+Shift+N",
        "mac": "Command+Shift+N"
      },
      "description": "Next track"
    },
    "toggle-pip": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Toggle Picture-in-Picture"
    },
    "previous-track": {
      "description": "Previous track"
    },
    "volume-up": {
      "description": "Increase volume"
    },
    "volume-down": {
      "description": "Decrease volume"
    },
    "mute-toggle": {
      "description": "Mute"
    },
    "toggle-shuffle": {
      "description": "Shuffle"
    },
    "toggle-repeat": {
      "description": "Repeat"
    },
    "toggle-like": {
      "description": "Like"
    },
    "toggle-dislike": {
      "description": "Dislike"
    },
    "sleep-timer": {
      "description": "Sleep timer"
    }
  }
}
